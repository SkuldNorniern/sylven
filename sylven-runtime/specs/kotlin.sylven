language {
  id "kotlin"
  extensions [".kt", ".kts"]
  comment.line "//"
  comment.block "/*" "*/"
}

tokens {
  control [
    "if", "else", "when", "for", "while", "do", "break", "continue", "return", "try", "catch",
    "finally", "throw"
  ]
  keyword [
    "package", "import", "class", "interface", "object", "fun", "val", "var", "typealias",
    "constructor", "init", "this", "super", "is", "as", "in", "out", "by", "companion", "data",
    "sealed", "enum", "open", "abstract", "override", "private", "protected", "public",
    "internal", "lateinit", "suspend", "inline", "reified", "operator"
  ]
  builtin.type [
    "Int", "Long", "Short", "Byte", "Double", "Float", "Boolean", "Char", "String", "Unit",
    "Any", "Nothing"
  ]
  const.lit [
    "true", "false", "null"
  ]
  block.comment "/*" to "*/"
  line.comment  "//" to newline
  ident         /[a-zA-Z_][a-zA-Z0-9_]*/
  hex           /0x[0-9a-fA-F_]+/
  float         /[0-9]+\.[0-9]+/
  int           /[0-9]+/
  string        /"([^"\\]|\\.)*"/
  char.lit      /'([^'\\]|\\.)*'/
  whitespace    /\s+/ trivia
  "==="  eqeqeq
  "!=="  neqeq
  ">>="  shreq
  "<<="  shleq
  "..."  ellipsis
  "**="  powreq
  "??="  nulleq
  "=>"   fatarrow
  "->"   arrow
  "::"   coloncolon
  "=="   eqeq
  "!="   ne
  "<="   le
  ">="   ge
  "<<"   shl
  ">>"   shr
  "++"   inc
  "--"   dec
  "+="   pluseq
  "-="   minuseq
  "*="   stareq
  "/="   slasheq
  "%="   percenteq
  "&="   ampeq
  "|="   pipeq
  "^="   careteq
  "&&"   andand
  "||"   oror
  "??"   nullish
  "?."   optchain
  "**"   pow
  "("    lparen
  ")"    rparen
  "{"    lbrace
  "}"    rbrace
  "["    lbracket
  "]"    rbracket
  "+"    plus
  "-"    minus
  "*"    star
  "/"    slash
  "%"    percent
  "&"    amp
  "|"    pipe
  "^"    caret
  "!"    bang
  "~"    tilde
  "<"    lt
  ">"    gt
  "="    eq
  "?"    question
  "."    dot
  ":"    colon
  ";"    semicolon
  ","    comma
  "#"    hash
  "@"    at
  "$"    dollar
  "\\"    backslash
}

highlight {
  token ident after "fun" -> function
  token ident after "class" -> type
  token ident after "interface" -> type
  token ident after "object" -> type
  token ident after "@" -> attribute
  token ident before "(" -> function
  token ident after "." -> property
  token ident upper -> constant
  token ident capitalized -> type
  token control       -> keyword.control
  token keyword       -> keyword
  token builtin.type  -> type
  token const.lit     -> number
  token string        -> string
  token char.lit      -> string
  token hex           -> number
  token float         -> number
  token int           -> number
  token line.comment  -> comment
  token block.comment -> comment
}

fold {
  Block when multiline
}
