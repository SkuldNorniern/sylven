language {
  id "shell"
  extensions [".sh", ".bash", ".zsh"]
  comment.line "#"
}

tokens {
  control [
    "if", "then", "else", "elif", "fi", "case", "esac", "for", "while", "until", "do", "done",
    "in", "select", "break", "continue", "return", "exit"
  ]
  keyword [
    "function", "local", "export", "readonly", "declare", "typeset", "unset", "source",
    "alias", "eval", "exec", "shift", "trap", "set", "echo", "printf", "read", "cd", "test"
  ]
  const.lit [
    "true", "false"
  ]
  line.comment  "#" to newline
  sigil0.var     /\$[a-zA-Z_][a-zA-Z0-9_]*/
  ident         /[a-zA-Z_][a-zA-Z0-9_]*/
  float         /[0-9]+\.[0-9]+/
  int           /[0-9]+/
  string        /"([^"\\]|\\.)*"/
  char.lit      /'([^'\\]|\\.)*'/
  whitespace    /\s+/ trivia
  "==="  eqeqeq
  "!=="  neqeq
  ">>="  shreq
  "<<="  shleq
  "..."  ellipsis
  "**="  powreq
  "??="  nulleq
  "=>"   fatarrow
  "->"   arrow
  "::"   coloncolon
  "=="   eqeq
  "!="   ne
  "<="   le
  ">="   ge
  "<<"   shl
  ">>"   shr
  "++"   inc
  "--"   dec
  "+="   pluseq
  "-="   minuseq
  "*="   stareq
  "/="   slasheq
  "%="   percenteq
  "&="   ampeq
  "|="   pipeq
  "^="   careteq
  "&&"   andand
  "||"   oror
  "??"   nullish
  "?."   optchain
  "**"   pow
  "("    lparen
  ")"    rparen
  "{"    lbrace
  "}"    rbrace
  "["    lbracket
  "]"    rbracket
  "+"    plus
  "-"    minus
  "*"    star
  "/"    slash
  "%"    percent
  "&"    amp
  "|"    pipe
  "^"    caret
  "!"    bang
  "~"    tilde
  "<"    lt
  ">"    gt
  "="    eq
  "?"    question
  "."    dot
  ":"    colon
  ";"    semicolon
  ","    comma
  "#"    hash
  "@"    at
  "$"    dollar
  "\\"    backslash
}

highlight {
  token ident after "function" -> function
  token ident before "(" -> function
  token control       -> keyword.control
  token keyword       -> keyword
  token const.lit     -> number
  token sigil0.var    -> variable
  token string        -> string
  token char.lit      -> string
  token float         -> number
  token int           -> number
  token line.comment  -> comment
}

fold {
  Block when multiline
}
