language {
  id "cpp"
  extensions [".cpp", ".cc", ".cxx", ".hpp", ".hh", ".hxx"]
  comment.line "//"
  comment.block "/*" "*/"
}

tokens {
  control [
    "if", "else", "for", "while", "do", "switch", "case", "default", "break", "continue",
    "return", "try", "catch", "finally", "throw", "goto", "co_await", "co_return", "co_yield"
  ]
  keyword [
    "alignas", "alignof", "auto", "class", "const", "constexpr", "consteval", "constinit",
    "const_cast", "decltype", "delete", "dynamic_cast", "enum", "explicit", "export", "extern",
    "friend", "inline", "mutable", "namespace", "new", "noexcept", "operator", "private",
    "protected", "public", "register", "reinterpret_cast", "requires", "sizeof", "static",
    "static_assert", "static_cast", "struct", "template", "this", "thread_local", "typedef",
    "typeid", "typename", "union", "using", "virtual", "volatile", "concept", "override",
    "final"
  ]
  builtin.type [
    "bool", "char", "char8_t", "char16_t", "char32_t", "wchar_t", "short", "int", "long",
    "signed", "unsigned", "float", "double", "void", "size_t"
  ]
  const.lit [
    "true", "false", "nullptr", "NULL"
  ]
  block.comment "/*" to "*/"
  line.comment  "//" to newline
  ident         /[a-zA-Z_][a-zA-Z0-9_]*/
  hex           /0x[0-9a-fA-F_]+/
  float         /[0-9]+\.[0-9]+/
  int           /[0-9]+/
  string        /"([^"\\]|\\.)*"/
  char.lit      /'([^'\\]|\\.)*'/
  whitespace    /\s+/ trivia
  "==="  eqeqeq
  "!=="  neqeq
  ">>="  shreq
  "<<="  shleq
  "..."  ellipsis
  "**="  powreq
  "??="  nulleq
  "=>"   fatarrow
  "->"   arrow
  "::"   coloncolon
  "=="   eqeq
  "!="   ne
  "<="   le
  ">="   ge
  "<<"   shl
  ">>"   shr
  "++"   inc
  "--"   dec
  "+="   pluseq
  "-="   minuseq
  "*="   stareq
  "/="   slasheq
  "%="   percenteq
  "&="   ampeq
  "|="   pipeq
  "^="   careteq
  "&&"   andand
  "||"   oror
  "??"   nullish
  "?."   optchain
  "**"   pow
  "("    lparen
  ")"    rparen
  "{"    lbrace
  "}"    rbrace
  "["    lbracket
  "]"    rbracket
  "+"    plus
  "-"    minus
  "*"    star
  "/"    slash
  "%"    percent
  "&"    amp
  "|"    pipe
  "^"    caret
  "!"    bang
  "~"    tilde
  "<"    lt
  ">"    gt
  "="    eq
  "?"    question
  "."    dot
  ":"    colon
  ";"    semicolon
  ","    comma
  "#"    hash
  "@"    at
  "$"    dollar
  "\\"    backslash
}

highlight {
  token ident after "class" -> type
  token ident after "struct" -> type
  token ident after "enum" -> type
  token ident after "union" -> type
  token ident after "typename" -> type
  token ident after "namespace" -> type
  token ident before "(" -> function
  token ident after "." -> property
  token ident upper -> constant
  token ident before "::" -> namespace
  token control       -> keyword.control
  token keyword       -> keyword
  token builtin.type  -> type
  token const.lit     -> number
  token string        -> string
  token char.lit      -> string
  token hex           -> number
  token float         -> number
  token int           -> number
  token line.comment  -> comment
  token block.comment -> comment
}

fold {
  Block when multiline
}
