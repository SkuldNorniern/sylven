language {
  id "ruby"
  extensions [".rb", ".rake", ".gemspec"]
  comment.line "#"
}

tokens {
  control [
    "if", "elsif", "else", "unless", "case", "when", "while", "until", "for", "break", "next",
    "redo", "retry", "return", "begin", "rescue", "ensure", "end", "then", "do", "yield",
    "raise"
  ]
  keyword [
    "def", "class", "module", "self", "super", "alias", "and", "or", "not", "in", "defined",
    "undef", "require", "require_relative", "include", "extend", "attr_reader", "attr_writer",
    "attr_accessor", "private", "protected", "public", "lambda", "proc"
  ]
  const.lit [
    "true", "false", "nil"
  ]
  line.comment  "#" to newline
  sigil0.var     /@[a-zA-Z_][a-zA-Z0-9_]*/
  ident         /[a-zA-Z_][a-zA-Z0-9_]*/
  hex           /0x[0-9a-fA-F_]+/
  float         /[0-9]+\.[0-9]+/
  int           /[0-9]+/
  string        /"([^"\\]|\\.)*"/
  char.lit      /'([^'\\]|\\.)*'/
  whitespace    /\s+/ trivia
  "==="  eqeqeq
  "!=="  neqeq
  ">>="  shreq
  "<<="  shleq
  "..."  ellipsis
  "**="  powreq
  "??="  nulleq
  "=>"   fatarrow
  "->"   arrow
  "::"   coloncolon
  "=="   eqeq
  "!="   ne
  "<="   le
  ">="   ge
  "<<"   shl
  ">>"   shr
  "++"   inc
  "--"   dec
  "+="   pluseq
  "-="   minuseq
  "*="   stareq
  "/="   slasheq
  "%="   percenteq
  "&="   ampeq
  "|="   pipeq
  "^="   careteq
  "&&"   andand
  "||"   oror
  "??"   nullish
  "?."   optchain
  "**"   pow
  "("    lparen
  ")"    rparen
  "{"    lbrace
  "}"    rbrace
  "["    lbracket
  "]"    rbracket
  "+"    plus
  "-"    minus
  "*"    star
  "/"    slash
  "%"    percent
  "&"    amp
  "|"    pipe
  "^"    caret
  "!"    bang
  "~"    tilde
  "<"    lt
  ">"    gt
  "="    eq
  "?"    question
  "."    dot
  ":"    colon
  ";"    semicolon
  ","    comma
  "#"    hash
  "@"    at
  "$"    dollar
  "\\"    backslash
}

highlight {
  token ident after "def" -> function
  token ident after "class" -> type
  token ident after "module" -> type
  token ident before "(" -> function
  token ident capitalized -> type
  token control       -> keyword.control
  token keyword       -> keyword
  token const.lit     -> number
  token sigil0.var    -> variable
  token string        -> string
  token char.lit      -> string
  token hex           -> number
  token float         -> number
  token int           -> number
  token line.comment  -> comment
}

fold {
  Block when multiline
}
