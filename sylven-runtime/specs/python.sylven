language {
  id "python"
  extensions [".py"]
  comment.line "#"
}

tokens {
  control [
    "await", "break", "continue", "elif", "else", "except", "finally",
    "for", "if", "pass", "raise", "return", "try", "while", "with",
    "yield"
  ]
  keyword [
    "False", "None", "True", "and", "as", "assert", "async", "class",
    "def", "del", "from", "global", "import", "in", "is", "lambda",
    "nonlocal", "not", "or"
  ]
  self.lit      ["self", "cls"]
  ident         /[a-zA-Z_][a-zA-Z0-9_]*/
  hex           /0x[0-9a-fA-F_]+/
  float         /[0-9]+\.[0-9]+/
  int           /[0-9]+/
  string        /"([^"\\]|\\.)*"/
  string.sq     /'([^'\\]|\\.)*'/
  line.comment  "#" to newline
  whitespace    /\s+/ trivia
  "**="  powerassign
  "//="  floordivassign
  "**"   power
  "//"   floordiv
  "=="   eqeq
  "!="   ne
  "<="   le
  ">="   ge
  "<<"   shl
  ">>"   shr
  "+="   pluseq
  "-="   minuseq
  "*="   stareq
  "/="   slasheq
  "%="   percenteq
  "&="   ampeq
  "|="   pipeq
  "^="   careteq
  "->"   arrow
  "..."  ellipsis
  "("    lparen
  ")"    rparen
  "{"    lbrace
  "}"    rbrace
  "["    lbracket
  "]"    rbracket
  "+"    plus
  "-"    minus
  "*"    star
  "/"    slash
  "%"    percent
  "&"    amp
  "|"    pipe
  "^"    caret
  "~"    tilde
  "<"    lt
  ">"    gt
  "="    eq
  "!"    bang
  "."    dot
  ":"    colon
  ";"    semicolon
  ","    comma
  "@"    at
}

highlight {
  token ident after "def" -> function
  token ident after "class" -> type
  token ident after "@" -> attribute
  token ident before "(" -> function
  token ident after "." -> property
  token ident upper -> constant
  token ident capitalized -> type
  token control      -> keyword.control
  token keyword      -> keyword
  token self.lit     -> variable
  token hex          -> number
  token string       -> string
  token string.sq    -> string
  token float        -> number
  token int          -> number
  token line.comment -> comment
}

fold {
  Block when multiline
}
