language {
  id "typescript"
  extensions [".ts", ".mts", ".cts", ".tsx"]
  comment.line "//"
  comment.block "/*" "*/"
}

tokens {
  control [
    "if", "else", "for", "while", "do", "switch", "case", "default", "break", "continue",
    "return", "try", "catch", "finally", "throw", "await", "yield"
  ]
  keyword [
    "var", "let", "const", "function", "class", "extends", "implements", "new", "delete",
    "typeof", "instanceof", "in", "of", "async", "import", "export", "from", "as", "this",
    "super", "static", "get", "set", "void", "interface", "type", "enum", "namespace",
    "module", "declare", "abstract", "public", "private", "protected", "readonly", "keyof",
    "infer", "is", "satisfies", "override"
  ]
  builtin.type [
    "string", "number", "boolean", "any", "unknown", "never", "object", "symbol", "bigint"
  ]
  const.lit [
    "true", "false", "null", "undefined"
  ]
  block.comment "/*" to "*/"
  line.comment  "//" to newline
  ident         /[a-zA-Z_][a-zA-Z0-9_]*/
  hex           /0x[0-9a-fA-F_]+/
  float         /[0-9]+\.[0-9]+/
  int           /[0-9]+/
  string        /"([^"\\]|\\.)*"/
  char.lit      /'([^'\\]|\\.)*'/
  raw.string    /`([^`\\]|\\.)*`/
  whitespace    /\s+/ trivia
  "==="  eqeqeq
  "!=="  neqeq
  ">>="  shreq
  "<<="  shleq
  "..."  ellipsis
  "**="  powreq
  "??="  nulleq
  "=>"   fatarrow
  "->"   arrow
  "::"   coloncolon
  "=="   eqeq
  "!="   ne
  "<="   le
  ">="   ge
  "<<"   shl
  ">>"   shr
  "++"   inc
  "--"   dec
  "+="   pluseq
  "-="   minuseq
  "*="   stareq
  "/="   slasheq
  "%="   percenteq
  "&="   ampeq
  "|="   pipeq
  "^="   careteq
  "&&"   andand
  "||"   oror
  "??"   nullish
  "?."   optchain
  "**"   pow
  "("    lparen
  ")"    rparen
  "{"    lbrace
  "}"    rbrace
  "["    lbracket
  "]"    rbracket
  "+"    plus
  "-"    minus
  "*"    star
  "/"    slash
  "%"    percent
  "&"    amp
  "|"    pipe
  "^"    caret
  "!"    bang
  "~"    tilde
  "<"    lt
  ">"    gt
  "="    eq
  "?"    question
  "."    dot
  ":"    colon
  ";"    semicolon
  ","    comma
  "#"    hash
  "@"    at
  "$"    dollar
  "\\"    backslash
}

highlight {
  token ident after "function" -> function
  token ident after "class" -> type
  token ident after "interface" -> type
  token ident after "type" -> type
  token ident after "enum" -> type
  token ident after "extends" -> type
  token ident after "implements" -> type
  token ident after "new" -> type
  token ident after ":" -> type
  token ident before "(" -> function
  token ident capitalized -> type
  token control       -> keyword.control
  token keyword       -> keyword
  token builtin.type  -> type
  token const.lit     -> number
  token string        -> string
  token char.lit      -> string
  token raw.string    -> string
  token hex           -> number
  token float         -> number
  token int           -> number
  token line.comment  -> comment
  token block.comment -> comment
}

fold {
  Block when multiline
}
