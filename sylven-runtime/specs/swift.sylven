language {
  id "swift"
  extensions [".swift"]
  comment.line "//"
  comment.block "/*" "*/"
}

tokens {
  control [
    "if", "else", "guard", "for", "while", "repeat", "switch", "case", "default", "break",
    "continue", "fallthrough", "return", "throw", "do", "catch", "try", "defer", "await"
  ]
  keyword [
    "import", "class", "struct", "enum", "protocol", "extension", "func", "var", "let", "init",
    "deinit", "subscript", "typealias", "associatedtype", "static", "public", "private",
    "fileprivate", "internal", "open", "final", "override", "mutating", "inout", "self",
    "Self", "super", "where", "in", "is", "as", "some", "any", "async", "throws", "rethrows",
    "lazy", "weak", "unowned"
  ]
  builtin.type [
    "Int", "Double", "Float", "Bool", "String", "Character", "Void", "Any", "Optional",
    "Array", "Dictionary", "Set"
  ]
  const.lit [
    "true", "false", "nil"
  ]
  block.comment "/*" to "*/"
  line.comment  "//" to newline
  ident         /[a-zA-Z_][a-zA-Z0-9_]*/
  hex           /0x[0-9a-fA-F_]+/
  float         /[0-9]+\.[0-9]+/
  int           /[0-9]+/
  string        /"([^"\\]|\\.)*"/
  char.lit      /'([^'\\]|\\.)*'/
  whitespace    /\s+/ trivia
  "==="  eqeqeq
  "!=="  neqeq
  ">>="  shreq
  "<<="  shleq
  "..."  ellipsis
  "**="  powreq
  "??="  nulleq
  "=>"   fatarrow
  "->"   arrow
  "::"   coloncolon
  "=="   eqeq
  "!="   ne
  "<="   le
  ">="   ge
  "<<"   shl
  ">>"   shr
  "++"   inc
  "--"   dec
  "+="   pluseq
  "-="   minuseq
  "*="   stareq
  "/="   slasheq
  "%="   percenteq
  "&="   ampeq
  "|="   pipeq
  "^="   careteq
  "&&"   andand
  "||"   oror
  "??"   nullish
  "?."   optchain
  "**"   pow
  "("    lparen
  ")"    rparen
  "{"    lbrace
  "}"    rbrace
  "["    lbracket
  "]"    rbracket
  "+"    plus
  "-"    minus
  "*"    star
  "/"    slash
  "%"    percent
  "&"    amp
  "|"    pipe
  "^"    caret
  "!"    bang
  "~"    tilde
  "<"    lt
  ">"    gt
  "="    eq
  "?"    question
  "."    dot
  ":"    colon
  ";"    semicolon
  ","    comma
  "#"    hash
  "@"    at
  "$"    dollar
  "\\"    backslash
}

highlight {
  token ident after "func" -> function
  token ident after "class" -> type
  token ident after "struct" -> type
  token ident after "enum" -> type
  token ident after "protocol" -> type
  token ident after "extension" -> type
  token ident before "(" -> function
  token ident after "." -> property
  token ident upper -> constant
  token ident capitalized -> type
  token control       -> keyword.control
  token keyword       -> keyword
  token builtin.type  -> type
  token const.lit     -> number
  token string        -> string
  token char.lit      -> string
  token hex           -> number
  token float         -> number
  token int           -> number
  token line.comment  -> comment
  token block.comment -> comment
}

fold {
  Block when multiline
}
