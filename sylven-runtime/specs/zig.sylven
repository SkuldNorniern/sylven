language {
  id "zig"
  extensions [".zig"]
  comment.line "//"
}

tokens {
  control [
    "if", "else", "switch", "for", "while", "break", "continue", "return", "try", "catch",
    "orelse", "defer", "errdefer", "unreachable"
  ]
  keyword [
    "const", "var", "fn", "pub", "struct", "enum", "union", "error", "comptime", "inline",
    "extern", "export", "test", "usingnamespace", "async", "await", "suspend", "resume", "and",
    "or", "packed", "opaque", "align", "noalias"
  ]
  builtin.type [
    "u8", "u16", "u32", "u64", "usize", "i8", "i16", "i32", "i64", "isize", "f32", "f64",
    "bool", "void", "type", "anytype", "noreturn", "anyerror", "comptime_int"
  ]
  const.lit [
    "true", "false", "null", "undefined"
  ]
  line.comment  "//" to newline
  sigil0.var     /@[a-zA-Z_][a-zA-Z0-9_]*/
  ident         /[a-zA-Z_][a-zA-Z0-9_]*/
  hex           /0x[0-9a-fA-F_]+/
  float         /[0-9]+\.[0-9]+/
  int           /[0-9]+/
  string        /"([^"\\]|\\.)*"/
  char.lit      /'([^'\\]|\\.)*'/
  whitespace    /\s+/ trivia
  "==="  eqeqeq
  "!=="  neqeq
  ">>="  shreq
  "<<="  shleq
  "..."  ellipsis
  "**="  powreq
  "??="  nulleq
  "=>"   fatarrow
  "->"   arrow
  "::"   coloncolon
  "=="   eqeq
  "!="   ne
  "<="   le
  ">="   ge
  "<<"   shl
  ">>"   shr
  "++"   inc
  "--"   dec
  "+="   pluseq
  "-="   minuseq
  "*="   stareq
  "/="   slasheq
  "%="   percenteq
  "&="   ampeq
  "|="   pipeq
  "^="   careteq
  "&&"   andand
  "||"   oror
  "??"   nullish
  "?."   optchain
  "**"   pow
  "("    lparen
  ")"    rparen
  "{"    lbrace
  "}"    rbrace
  "["    lbracket
  "]"    rbracket
  "+"    plus
  "-"    minus
  "*"    star
  "/"    slash
  "%"    percent
  "&"    amp
  "|"    pipe
  "^"    caret
  "!"    bang
  "~"    tilde
  "<"    lt
  ">"    gt
  "="    eq
  "?"    question
  "."    dot
  ":"    colon
  ";"    semicolon
  ","    comma
  "#"    hash
  "@"    at
  "$"    dollar
  "\\"    backslash
}

highlight {
  token ident after "fn" -> function
  token ident before "(" -> function
  token control       -> keyword.control
  token keyword       -> keyword
  token builtin.type  -> type
  token const.lit     -> number
  token sigil0.var    -> variable
  token string        -> string
  token char.lit      -> string
  token hex           -> number
  token float         -> number
  token int           -> number
  token line.comment  -> comment
}

fold {
  Block when multiline
}
